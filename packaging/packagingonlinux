#!/usr/bin/env python3
"""Launcher installed as /usr/bin/packagingonlinux by the self-packaging config.

/usr/bin/packagingonlinux is a symlink to /usr/lib/packagingonlinux/bin/packagingonlinux;
the `packagingonlinux` package sits in /usr/lib/packagingonlinux/. With no arguments (desktop menu) it opens
the GUI; otherwise it behaves like the CLI.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from packagingonlinux.cli import main  # noqa: E402

raise SystemExit(main(sys.argv[1:] or ["gui"]))

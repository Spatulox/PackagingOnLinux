#!/usr/bin/env python3
"""Launcher installed as /usr/bin/compileonlinux by the self-packaging config.

/usr/bin/compileonlinux is a symlink to /usr/lib/compileonlinux/bin/compileonlinux;
the `compileonlinux` package sits in /usr/lib/compileonlinux/. With no arguments (desktop menu) it opens
the GUI; otherwise it behaves like the CLI.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from compileonlinux.cli import main  # noqa: E402

raise SystemExit(main(sys.argv[1:] or ["gui"]))
